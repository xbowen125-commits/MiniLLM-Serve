# Copy to .env only when local overrides are needed. Never commit real tokens.
# Docker Compose publishes this host port on 127.0.0.1 only.
MINILLM_HOST_PORT=8000
MINILLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
MINILLM_DTYPE=float16
MINILLM_MAX_MODEL_LEN=2048
MINILLM_USE_KV_CACHE=true
MINILLM_MAX_CONCURRENT_GENERATIONS=1
MINILLM_REQUEST_QUEUE_CAPACITY=8
MINILLM_QUEUE_TIMEOUT_SECONDS=30
MINILLM_INFERENCE_TIMEOUT_SECONDS=180
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
